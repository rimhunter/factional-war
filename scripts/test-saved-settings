#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
work="$(mktemp -d "${TMPDIR:-/tmp}/factionalwar-saved-settings.XXXXXX")"
trap 'rm -rf "$work"' EXIT
echo "launch 1: change the settings in the mod settings window and close it"
"$here/scripts/run-scenarios" --windowed --work-dir "$work" -s settings-changed-in-the-settings-window-are-written-to-the-file "$@"
file="$(find "$work" -path '*/savedata/Config/Mod_*_SettingWindow.xml' | head -n 1)"
[ -n "$file" ] || { echo "test-saved-settings: launch 1 left no settings file under $work" >&2; exit 1; }
echo "launch 2: start the game again with the file launch 1 wrote and read the values"
"$here/scripts/run-scenarios" --windowed --work-dir "$work" --seed-config "$file:$(basename "$file")" -s settings-saved-values-apply-after-restart "$@"
