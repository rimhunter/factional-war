#!/usr/bin/env python3
import math
import os
import sys
from PIL import Image, ImageDraw, ImageFont

HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FONT = "/usr/share/fonts/open-sans/OpenSans-Bold.ttf"

BLUE = (0, 114, 178, 255)
ORANGE = (230, 159, 0, 255)
SKY = (86, 180, 233, 255)
RED = (213, 94, 0, 255)
INK = (24, 28, 34, 255)
PAPER = (240, 234, 214, 255)
STEEL = (200, 206, 214, 255)
SKIN = (236, 200, 160, 255)


class Pen:
    def __init__(self, w, h, scale):
        self.s = scale
        self.im = Image.new("RGBA", (w * scale, h * scale), (0, 0, 0, 0))
        self.d = ImageDraw.Draw(self.im)

    def _pts(self, pts):
        return [(x * self.s, y * self.s) for x, y in pts]

    def poly(self, pts, fill, outline=INK, width=2):
        p = self._pts(pts)
        self.d.polygon(p, fill=fill)
        self.d.line(p + [p[0]], fill=outline, width=int(width * self.s), joint="curve")

    def rect(self, x0, y0, x1, y1, fill, outline=INK, width=2):
        self.d.rectangle([x0 * self.s, y0 * self.s, x1 * self.s, y1 * self.s], fill=fill, outline=outline, width=int(width * self.s))

    def circle(self, cx, cy, r, fill=None, outline=INK, width=2):
        self.d.ellipse([(cx - r) * self.s, (cy - r) * self.s, (cx + r) * self.s, (cy + r) * self.s], fill=fill, outline=outline, width=int(width * self.s) if outline else 0)

    def line(self, a, b, fill, width):
        self.d.line(self._pts([a, b]), fill=fill, width=int(width * self.s))

    def done(self, w, h):
        return self.im.resize((w, h), Image.LANCZOS)


def arrow(p, x0, y, x1, fill):
    s = 1 if x1 > x0 else -1
    head = 9
    p.poly([(x0, y - 3), (x1 - s * head, y - 3), (x1 - s * head, y - 8), (x1, y), (x1 - s * head, y + 8), (x1 - s * head, y + 3), (x0, y + 3)], fill)


def camp():
    p = Pen(64, 64, 8)
    p.poly([(6, 52), (32, 12), (58, 52)], ORANGE, width=3)
    p.poly([(26, 52), (32, 34), (38, 52)], INK, width=1)
    p.line((32, 12), (32, 3), INK, 3)
    p.poly([(32, 3), (45, 7), (32, 12)], SKY)
    p.line((4, 55), (60, 55), INK, 3)
    return p.done(64, 64)


def contention():
    p = Pen(64, 64, 8)
    p.rect(20, 18, 44, 46, SKY, width=3)
    p.line((20, 32), (44, 32), INK, 3)
    p.line((32, 18), (32, 46), INK, 3)
    arrow(p, 1, 56, 24, ORANGE)
    arrow(p, 63, 8, 40, RED)
    return p.done(64, 64)


def shelling():
    p = Pen(64, 64, 8)
    pts = []
    for i in range(16):
        a = math.pi * 2 * i / 16 - math.pi / 2
        r = 25 if i % 2 == 0 else 12
        pts.append((22 + math.cos(a) * r, 24 + math.sin(a) * r))
    p.poly(pts, RED)
    p.circle(22, 24, 6, fill=ORANGE)
    for i in range(1, 8):
        t = i / 8
        p.circle(54 - 24 * t, 52 - 20 * t - 12 * math.sin(math.pi * t), 2.8, fill=INK, outline=None)
    p.rect(40, 54, 62, 60, STEEL)
    return p.done(64, 64)


def expand(color):
    p = Pen(64, 64, 8)
    p.circle(32, 32, 29, outline=INK, width=7)
    p.circle(32, 32, 29, outline=color, width=4)
    p.circle(32, 32, 18, outline=INK, width=6)
    p.circle(32, 32, 18, outline=color, width=3)
    return p.done(64, 64)


def sites():
    out = os.path.join(HERE, "Textures", "World", "WorldObjects", "Sites")
    os.makedirs(out, exist_ok=True)
    for name, img in (
        ("FactionTempCamp", camp()),
        ("FactionTempCampExpand", expand(ORANGE)),
        ("FactionWarContention", contention()),
        ("FactionWarContentionExpand", expand(SKY)),
        ("FactionWarShelling", shelling()),
        ("FactionWarShellingExpand", expand(RED)),
    ):
        img.save(os.path.join(out, name + ".png"), optimize=True)


def soldier(p, cx, base, h, body):
    w = h * 0.55
    p.poly([(cx - w / 2, base), (cx - w * 0.32, base - h * 0.62), (cx + w * 0.32, base - h * 0.62), (cx + w / 2, base)], body)
    p.circle(cx, base - h * 0.80, h * 0.19, fill=SKIN)


def guard(p, cx, base, h, body):
    w = h * 0.5
    p.rect(cx - w / 2, base - h * 0.62, cx + w / 2, base, body)
    p.rect(cx - w * 0.36, base - h * 0.99, cx + w * 0.36, base - h * 0.66, SKIN)


def sword(p, cx, cy, angle, length, hilt):
    dx, dy = math.cos(angle), math.sin(angle)
    nx, ny = -dy, dx
    tip = (cx + dx * length / 2, cy + dy * length / 2)
    pom = (cx - dx * length / 2, cy - dy * length / 2)
    g = (cx - dx * length * 0.18, cy - dy * length * 0.18)
    p.poly([(g[0] + nx * 8, g[1] + ny * 8), tip, (g[0] - nx * 8, g[1] - ny * 8)], STEEL, width=3)
    p.line(g, pom, INK, 11)
    p.line(g, pom, hilt, 6)
    p.line((g[0] + nx * 26, g[1] + ny * 26), (g[0] - nx * 26, g[1] - ny * 26), INK, 11)
    p.line((g[0] + nx * 24, g[1] + ny * 24), (g[0] - nx * 24, g[1] - ny * 24), hilt, 6)


def preview():
    W, H, S = 1024, 576, 2
    base = Image.new("RGBA", (W * S, H * S), (0, 0, 0, 255))
    d = ImageDraw.Draw(base)
    for y in range(H * S):
        t = y / (H * S)
        d.line([(0, y), (W * S, y)], fill=(int(34 + 30 * t), int(46 + 36 * t), int(52 + 22 * t), 255))
    for x in range(0, W * S, 64 * S):
        d.line([(x, 0), (x, H * S)], fill=(80, 96, 100, 255), width=2)
    for y in range(0, H * S, 64 * S):
        d.line([(0, y), (W * S, y)], fill=(80, 96, 100, 255), width=2)
    d.rectangle([0, 384 * S, W * S, H * S], fill=(18, 22, 26, 255))
    d.line([(0, 384 * S), (W * S, 384 * S)], fill=PAPER, width=3 * S)

    p = Pen(W, H, S)
    for row in range(3):
        for col in range(3):
            cx = 70 + col * 78 + (row % 2) * 30
            ground = 250 + row * 55
            soldier(p, cx, ground, 100, BLUE)
            guard(p, W - cx, ground, 100, RED)
    sword(p, 512, 200, math.radians(-40), 230, ORANGE)
    sword(p, 512, 200, math.radians(-140), 230, SKY)
    im = Image.alpha_composite(base, p.im)

    d = ImageDraw.Draw(im)
    title = ImageFont.truetype(FONT, 100 * S)
    sub = ImageFont.truetype(FONT, 36 * S)
    for text, font, y, fill in (("Factional War", title, 394, PAPER), ("for RimWorld 1.6 and 1.7", sub, 508, STEEL)):
        x = (W * S - d.textlength(text, font=font)) / 2
        d.text((x + 4 * S, y * S + 4 * S), text, font=font, fill=(0, 0, 0, 255))
        d.text((x, y * S), text, font=font, fill=fill)
    im.convert("RGB").resize((W, H), Image.LANCZOS).save(os.path.join(HERE, "About", "Preview.png"), optimize=True)


if __name__ == "__main__":
    if not os.path.isfile(FONT):
        sys.exit("make-art: the font %s is missing" % FONT)
    sites()
    preview()
